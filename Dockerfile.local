# Pulled through a Docker Hub mirror. Override with build-arg RUST_IMAGE / DEBIAN_IMAGE.
ARG RUST_IMAGE=docker.m.daocloud.io/library/rust:1-bookworm
ARG DEBIAN_IMAGE=docker.m.daocloud.io/library/debian:bookworm-slim

FROM ${RUST_IMAGE} AS builder

RUN if [ -f /etc/apt/sources.list ]; then sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list; fi \
    && if [ -f /etc/apt/sources.list.d/debian.sources ]; then sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources; fi

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        pkg-config \
        autoconf \
        automake \
        libtool \
        m4 \
        sqlite3 \
        libsqlite3-dev \
        libx11-dev \
        libxext-dev \
        libxft-dev \
        libxinerama-dev \
        libxcursor-dev \
        libxrandr-dev \
        libxrender-dev \
        libxi-dev \
        libxtst-dev \
        libxss-dev \
        libxpresent-dev \
        libwayland-dev \
        libxkbcommon-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

# GitHub is unreachable from this server. These checkouts are the exact commits from Cargo.lock.
RUN missing=0; \
    for f in \
      libs/hbb_common/Cargo.toml \
      third_party/tungstenite-rs/Cargo.toml \
      third_party/tokio-tungstenite/Cargo.toml \
      third_party/reqwest/Cargo.toml \
      third_party/confy/Cargo.toml \
      third_party/tokio-socks/Cargo.toml \
      third_party/sysinfo/Cargo.toml \
      third_party/default_net/Cargo.toml \
      third_party/machine-uid/Cargo.toml \
      third_party/async-speed-limit/Cargo.toml; \
    do \
      if [ ! -f "$f" ]; then echo "missing $f"; missing=1; fi; \
    done; \
    if [ "$missing" = 1 ]; then \
      echo "Upload libs/hbb_common and third_party together with this Dockerfile. A GitHub zip does not contain them."; \
      exit 1; \
    fi

RUN sed -i \
        -e 's|async-speed-limit = { git = "https://github.com/open-trade/async-speed-limit" }|async-speed-limit = { path = "third_party/async-speed-limit" }|' \
        -e 's|tokio-tungstenite = { git = "https://github.com/rustdesk-org/tokio-tungstenite", rev = "c241b11b03de4881faf1ecd2fe6e867c92f3013b", version = "0.29" }|tokio-tungstenite = { path = "third_party/tokio-tungstenite", version = "0.29" }|' \
        -e 's|git = "https://github.com/rustdesk-org/reqwest"|path = "third_party/reqwest"|g' \
        -e 's|tungstenite = { git = "https://github.com/rustdesk-org/tungstenite-rs", rev = "efce47e5364f00a63302cf07ab1fb13ded478914" }|tungstenite = { path = "third_party/tungstenite-rs" }|' \
        Cargo.toml \
    && sed -i \
        -e 's|confy = { git = "https://github.com/rustdesk-org/confy" }|confy = { path = "../../third_party/confy" }|' \
        -e 's|tokio-socks = { git = "https://github.com/rustdesk-org/tokio-socks" }|tokio-socks = { path = "../../third_party/tokio-socks" }|' \
        -e 's|sysinfo = { git = "https://github.com/rustdesk-org/sysinfo", branch = "rlim_max" }|sysinfo = { path = "../../third_party/sysinfo" }|' \
        -e 's|default_net = { git = "https://github.com/rustdesk-org/default_net" }|default_net = { path = "../../third_party/default_net" }|' \
        -e 's|machine-uid = { git = "https://github.com/rustdesk-org/machine-uid" }|machine-uid = { path = "../../third_party/machine-uid" }|' \
        libs/hbb_common/Cargo.toml \
    && sed -i 's|read-initializer = \["futures-io/unstable", "futures-io/read-initializer"\]|read-initializer = []|' \
        third_party/async-speed-limit/Cargo.toml \
    && sed -i '/feature(read_initializer)/d' third_party/async-speed-limit/src/lib.rs \
    && sed -i 's|#\[cfg(feature = "read-initializer")\]|#[cfg(any())]|' third_party/async-speed-limit/src/io.rs \
    && sed -i '/^source = "git+/d' Cargo.lock

# sqlx query! checks this schema at compile time. The running server uses DB_URL, not DATABASE_URL.
ENV DATABASE_URL=sqlite:///src/db_v2.sqlite3
RUN printf '%s\n' \
        '[source.crates-io]' \
        'replace-with = "aliyun"' \
        '' \
        '[source.aliyun]' \
        'registry = "sparse+https://mirrors.aliyun.com/crates.io-index/"' \
        > /usr/local/cargo/config.toml
RUN sqlite3 /src/db_v2.sqlite3 "CREATE TABLE IF NOT EXISTS peer (guid BLOB PRIMARY KEY NOT NULL, id VARCHAR(100) NOT NULL, uuid BLOB NOT NULL, pk BLOB NOT NULL, created_at DATETIME NOT NULL DEFAULT(CURRENT_TIMESTAMP), user BLOB, status TINYINT, note VARCHAR(300), info TEXT NOT NULL) WITHOUT ROWID;"

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/target \
    cargo build --locked --release --bin hbbs --bin hbbr \
    && mkdir -p /out \
    && cp /src/target/release/hbbs /src/target/release/hbbr /out/

FROM ${DEBIAN_IMAGE}

RUN if [ -f /etc/apt/sources.list ]; then sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list; fi \
    && if [ -f /etc/apt/sources.list.d/debian.sources ]; then sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources; fi

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libsqlite3-0 \
        libx11-6 \
        libxext6 \
        libxft2 \
        libxinerama1 \
        libxcursor1 \
        libxrandr2 \
        libxrender1 \
        libxi6 \
        libxtst6 \
        libxss1 \
        libxpresent1 \
        libwayland-client0 \
        libwayland-cursor0 \
        libwayland-egl1 \
        libxkbcommon0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/hbbs /usr/bin/hbbs
COPY --from=builder /out/hbbr /usr/bin/hbbr

WORKDIR /root
ENV HOME=/root
