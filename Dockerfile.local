# Pulled through a Docker Hub mirror. Override with build-arg RUST_IMAGE / DEBIAN_IMAGE.
ARG RUST_IMAGE=docker.m.daocloud.io/library/rust:1-bookworm
ARG DEBIAN_IMAGE=docker.m.daocloud.io/library/debian:bookworm-slim

FROM ${RUST_IMAGE} AS builder

RUN if [ -f /etc/apt/sources.list ]; then sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list; fi \
    && if [ -f /etc/apt/sources.list.d/debian.sources ]; then sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources; fi

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        pkg-config \
        autoconf \
        automake \
        libtool \
        m4 \
        sqlite3 \
        libsqlite3-dev \
        libx11-dev \
        libxext-dev \
        libxft-dev \
        libxinerama-dev \
        libxcursor-dev \
        libxrandr-dev \
        libxrender-dev \
        libxi-dev \
        libxtst-dev \
        libxss-dev \
        libxpresent-dev \
        libwayland-dev \
        libxkbcommon-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

# libs/hbb_common is a git submodule (69cea8dafee147848ae88702029f4bf7df7224c3) and is not in the image context until it is checked out.
RUN if [ ! -f libs/hbb_common/Cargo.toml ]; then \
      rev=69cea8dafee147848ae88702029f4bf7df7224c3; \
      ok=0; \
      for url in \
        https://github.com/rustdesk/hbb_common.git \
        https://kkgithub.com/rustdesk/hbb_common.git \
        https://ghfast.top/https://github.com/rustdesk/hbb_common.git; \
      do \
        echo "fetch hbb_common from $url"; \
        rm -rf libs/hbb_common; \
        git init libs/hbb_common \
          && git -C libs/hbb_common remote add origin "$url" \
          && git -C libs/hbb_common fetch --depth 1 origin "$rev" \
          && git -C libs/hbb_common checkout --detach FETCH_HEAD \
          && ok=1 && break; \
      done; \
      test "$ok" = 1; \
    fi

# sqlx query! checks this schema at compile time. The running server uses DB_URL, not DATABASE_URL.
ENV DATABASE_URL=sqlite:///src/db_v2.sqlite3
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
RUN printf '%s\n' \
        '[net]' \
        'git-fetch-with-cli = true' \
        '' \
        '[source.crates-io]' \
        'replace-with = "aliyun"' \
        '' \
        '[source.aliyun]' \
        'registry = "sparse+https://mirrors.aliyun.com/crates.io-index/"' \
        > /usr/local/cargo/config.toml \
    && git config --global url."https://kkgithub.com/".insteadOf "https://github.com/"
RUN sqlite3 /src/db_v2.sqlite3 "CREATE TABLE IF NOT EXISTS peer (guid BLOB PRIMARY KEY NOT NULL, id VARCHAR(100) NOT NULL, uuid BLOB NOT NULL, pk BLOB NOT NULL, created_at DATETIME NOT NULL DEFAULT(CURRENT_TIMESTAMP), user BLOB, status TINYINT, note VARCHAR(300), info TEXT NOT NULL) WITHOUT ROWID;"

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/target \
    cargo build --release --all-features \
    && mkdir -p /out \
    && cp /src/target/release/hbbs /src/target/release/hbbr /out/

FROM ${DEBIAN_IMAGE}

RUN if [ -f /etc/apt/sources.list ]; then sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list; fi \
    && if [ -f /etc/apt/sources.list.d/debian.sources ]; then sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources; fi

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libsqlite3-0 \
        libx11-6 \
        libxext6 \
        libxft2 \
        libxinerama1 \
        libxcursor1 \
        libxrandr2 \
        libxrender1 \
        libxi6 \
        libxtst6 \
        libxss1 \
        libxpresent1 \
        libwayland-client0 \
        libwayland-cursor0 \
        libwayland-egl1 \
        libxkbcommon0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/hbbs /usr/bin/hbbs
COPY --from=builder /out/hbbr /usr/bin/hbbr

WORKDIR /root
ENV HOME=/root
